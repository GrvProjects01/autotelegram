[Unit]
Description=Telegram Automation Worker - session %i
After=network-online.target
Wants=network-online.target
# Worker de longa duracao: nunca deve ficar permanentemente offline apenas
# porque houve varias falhas seguidas. O backoff fica em RestartSec.
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/autotelegram/autotelegram
EnvironmentFile=/home/ubuntu/autotelegram/autotelegram/.env
EnvironmentFile=/home/ubuntu/autotelegram/autotelegram/sessions/%i.env
ExecStart=/home/ubuntu/autotelegram/autotelegram/venv/bin/python /home/ubuntu/autotelegram/autotelegram/session_worker_history.py
# Este processo e um daemon. Reinicia tanto em falha quanto em saida inesperada limpa.
Restart=always
RestartSec=20
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
